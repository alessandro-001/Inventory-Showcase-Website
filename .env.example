# Template for the full version with a backend (README → "Going further: connect a real backend").
# The demo itself reads none of these.
#
# Copy this file to .env (git-ignored, never committed) for local development, and set the same names in your
# host's environment settings (Netlify: Site configuration → Environment variables) for production.
# These are server-side secrets: never prefix them with VITE_, because Vite copies VITE_* values into the public
# JavaScript bundle.

# Postgres connection string, e.g. from Neon or Supabase (both have free tiers)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Login: a hash of the shared password (scrypt or bcrypt), never the password itself
LOGIN_PASSWORD_HASH=

# DigiKey Product Information API v4: https://developer.digikey.com
# Create an organization and an app, then copy its Client ID and Client Secret (production, not sandbox).
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Mouser Search API: https://www.mouser.com/api-search/ (sign in, request a Search API key)
MOUSER_API_KEY=
